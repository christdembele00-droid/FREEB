# FREEB backend runtime variables.
# Never commit real credentials or service-account keys.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE?ssl=require
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ALLOWED_ORIGINS=https://YOUR-FREEB-WEB-DOMAIN
# Set true only for the first deployment when the PostgreSQL database is empty.
# After the initial schema bootstrap, prefer migrations and set this to false.
AUTO_CREATE_DB=false
MAX_UPLOAD_BYTES=104857600
